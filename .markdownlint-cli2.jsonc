// Relaxed markdownlint rules: structure and consistency, not prose style.
{
  "config": {
    "default": true,
    "MD013": false, // line length
    "MD033": false, // inline HTML
    "MD024": { "siblings_only": true }, // repeated headings in different sections
    "MD041": false // first line need not be a heading
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**"]
}
